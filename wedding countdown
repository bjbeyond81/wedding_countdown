<!DOCTYPE html>
<html lang="en">
<head><style>
@font-face {
  font-family: "Optimistic";
  font-style: normal;
  font-weight: 400 600;
  font-display: swap;
  src: url("/fonts/OptimisticAI_VF_Optimized.woff2") format("woff2");
}
@font-face {
  font-family: "Optimistic Mono";
  font-style: normal;
  font-weight: 400;
  font-display: swap;
  src: url("/fonts/OptimisticMono_W_TextRegular.woff2") format("woff2");
}
:where(html) {
  font-family: "Optimistic", system-ui, sans-serif;
}
:where(code, pre, kbd, samp) {
  font-family: "Optimistic Mono", ui-monospace, monospace;
}
</style>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="Countdown BJ ED">
<title>Our Countdown - BJ EDITION - Daily Love Phrase</title>
<style>
:root{--cream:#FFFBF7;--blush:#F6D5C8;--sage:#8A9A7B;--charcoal:#2D2D2D;--gold:#C9A86A;--line:rgba(45,45,45,.08)}
*{box-sizing:border-box;margin:0;padding:0}
body{background:var(--cream);color:var(--charcoal);font-family:-apple-system,BlinkMacSystemFont,Inter,sans-serif;min-height:100vh}
.header{max-width:720px;margin:0 auto;padding:24px 20px 12px;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px}
.header input{background:white;border:1px solid var(--line);border-radius:999px;padding:8px 14px;font-size:14px;width:130px}
.header input[type=date]{width:170px}
.hero{max-width:720px;margin:12px auto;padding:0 20px}
.count-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin:16px 0}
.count-box{background:white;border:1px solid var(--line);border-radius:20px;padding:14px;text-align:center;box-shadow:0 4px 16px rgba(0,0,0,.04)}
.count-box b{font-size:28px;display:block;font-family:Didot,Georgia,serif}
.count-box span{font-size:10px;letter-spacing:1.5px;text-transform:uppercase;opacity:.5}
.progress{height:8px;background:#eee;border-radius:999px;overflow:hidden;margin:12px 0}
.progress i{display:block;height:100%;background:linear-gradient(90deg,var(--sage),var(--gold))}
.quote-card{max-width:720px;margin:20px auto;background:white;border:1px solid var(--line);border-radius:28px;padding:28px 24px;box-shadow:0 12px 40px rgba(0,0,0,.06);position:relative;overflow:hidden}
.quote-card:before{content:'';position:absolute;top:0;left:0;right:0;height:4px;background:linear-gradient(90deg,var(--sage),var(--blush),var(--gold))}
.q-text{font-size:23px;line-height:1.4;font-family:Didot,Georgia,serif;margin:12px 0 16px}
.badge{padding:4px 10px;border-radius:999px;font-size:10px;letter-spacing:1px;text-transform:uppercase}
.badge-love{background:#F6D5C8;color:#7A3A2D}
.badge-romantic{background:#E8F5E9;color:#2E7D32}
.badge-tip{background:#FFF3E0;color:#8D5E00}
.badge-funny{background:#E3F2FD;color:#1565C0}
.badge-vow{background:#F3E5F5;color:#6A1B9A}
.btn{border:0;border-radius:999px;padding:10px 16px;font-size:13px;cursor:pointer}
.btn-dark{background:var(--charcoal);color:white}
.btn-ghost{background:white;border:1px solid var(--line)}
.tabs{max-width:720px;margin:0 auto;padding:0 20px;display:flex;gap:8px;overflow:auto}
.tab{padding:8px 14px;border-radius:999px;border:1px solid var(--line);background:white;font-size:12px;white-space:nowrap;cursor:pointer}
.tab.active{background:var(--charcoal);color:white}
.list{max-width:720px;margin:12px auto;padding:0 20px 80px;display:grid;gap:10px}
.mini{background:white;border:1px solid var(--line);border-radius:16px;padding:12px 14px;font-size:13px}
.small{font-size:11px;letter-spacing:1.2px;text-transform:uppercase;opacity:.5}
.toast{position:fixed;bottom:20px;left:50%;transform:translateX(-50%);background:var(--charcoal);color:white;padding:10px 18px;border-radius:999px;font-size:12px;opacity:0;transition:.3s;pointer-events:none;z-index:99}
.toast.show{opacity:1}
</style>
</head>
<body>
<div class="header">
  <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap">
    <div style="display:flex;align-items:center;gap:6px;background:white;border:1px solid var(--line);border-radius:999px;padding:4px 10px">
      <span class="small" style="margin-right:4px">✏️ Editable names:</span>
      <input id="c1" value="Alex" style="border:0;background:transparent;width:90px;font-weight:600;text-align:center" title="Click to edit">
      <span style="font-family:Didot,Georgia,serif">&</span>
      <input id="c2" value="Taylor" style="border:0;background:transparent;width:90px;font-weight:600;text-align:center" title="Click to edit">
    </div>
    <input id="wDate" type="date">
    <button class="btn btn-ghost" onclick="editNames()" style="font-size:11px">✎ Edit names</button>
  </div>
  <div class="small">BJ EDITION • Private • Tap the names to edit</div>
</div>
<div class="hero">
  <div id="heroTitle" style="font-family:Didot,Georgia,serif;font-size:32px;line-height:1.1;cursor:pointer" onclick="editNames()" title="Tap to edit the names"></div>
  <div id="sub" class="small" style="margin-top:6px"></div>
  <div class="count-grid" id="countGrid"></div>
  <div class="progress"><i id="prog" style="width:0%"></i></div>
  <div style="display:flex;justify-content:space-between"><span class="small" id="dayInfo"></span><span class="small" id="todayInfo"></span></div>
</div>
<div class="quote-card" id="quoteCard"></div>
<div class="tabs" id="tabs"></div>
<div class="list" id="list"></div>
<div class="toast" id="toast"></div>
<script>
const LS='weddingCountdownBJEDV2';
const quotes=[
{ text:"Love is not how many times you say 'I love you,' but how often you show that it is true.", author:"Unknown", cat:"Love"},
{ text:"The best thing to hold onto in life is each other.", author:"Audrey Hepburn", cat:"Romantic"},
{ text:"Every love story is beautiful, but ours is my favorite. — BJ EDITION", author:"BJ EDITION", cat:"Love"},
{ text:"You are my today and all of my tomorrows.", author:"Leo Christopher", cat:"Romantic"},
{ text:"Today: Write your vows from the heart, not from Pinterest. Your love will feel the difference.", author:"Daily Tip", cat:"Tip"},
{ text:"A great marriage is not when the perfect couple comes together. It is when an imperfect couple learns to enjoy their differences.", author:"Dave Meurer", cat:"Love"},
{ text:"The highest happiness on earth is the happiness of marriage.", author:"William Lyon Phelps", cat:"Romantic"},
{ text:"Today: Spend 15 minutes together without phones. Just the two of you.", author:"Daily Tip", cat:"Tip"},
{ text:"Love recognizes no barriers. It jumps hurdles and crosses walls to arrive full of hope.", author:"Maya Angelou", cat:"Love"},
{ text:"Being deeply loved gives you strength, while loving deeply gives you courage.", author:"Lao Tzu", cat:"Romantic"},
{ text:"They always laugh at my terrible jokes — that is one reason I love them.", author:"BJ EDITION", cat:"Funny"},
{ text:"Today: Send a voice note sharing one small thing you love about your partner today.", author:"Daily Tip", cat:"Tip"},
{ text:"In all the world, there is no heart for me like yours.", author:"Maya Angelou", cat:"Vow"},
{ text:"We are most alive when we are in love.", author:"John Updike", cat:"Romantic"},
{ text:"Today: Choose your first-dance song and dance together in the kitchen.", author:"Daily Tip", cat:"Tip"},
{ text:"Love is like the wind: you cannot see it, but you can feel it.", author:"Nicholas Sparks", cat:"Love"},
{ text:"I love you more than yesterday, but less than tomorrow.", author:"Rosemonde Gérard", cat:"Vow"},
{ text:"The best weddings are not the ones with the prettiest decor, but the ones with the most love in the room.", author:"Daily Tip", cat:"Tip"},
{ text:"You know you are in love when reality is finally better than your dreams.", author:"Dr. Seuss", cat:"Funny"},
{ text:"Today: Write down three things you appreciate about your love.", author:"Daily Tip", cat:"Tip"},
{ text:"To love and be loved is to feel the sun from both sides.", author:"David Viscott", cat:"Romantic"},
{ text:"I choose you. And I will choose you again and again, without pause.", author:"Unknown", cat:"Vow"},
{ text:"Today: Take a 20-minute walk together. No wedding talk for the first ten minutes.", author:"Daily Tip", cat:"Tip"},
{ text:"Love is friendship set to music.", author:"Joseph Campbell", cat:"Love"},
{ text:"In your light, I learn how to love.", author:"Rumi", cat:"Romantic"},
{ text:"Today: Something will go off plan at your wedding. Laugh about it now — it may become your favorite story.", author:"Daily Tip", cat:"Funny"},
{ text:"Two souls, one heart — BJ EDITION.", author:"BJ EDITION", cat:"Vow"},
];
let customQuotes=[],favorites=[],data={c1:'Alex',c2:'Taylor',date:new Date(Date.now()+200*86400000).toISOString().split('T')[0]};
try{const s=localStorage.getItem(LS); if(s){const p=JSON.parse(s); data={...data,...p.data}; customQuotes=p.customQuotes||[]; favorites=p.favorites||[];}}catch{}
function save(){try{localStorage.setItem(LS,JSON.stringify({data,customQuotes,favorites}));}catch{}}
function toast(m){const t=document.getElementById('toast'); t.textContent=m; t.classList.add('show'); setTimeout(()=>t.classList.remove('show'),2000);}
function getDailyIndex(off=0){return Math.abs(Math.floor((Date.now()+off*86400000)/86400000))%(quotes.length+customQuotes.length||1);}
function getQuote(idx){const all=[...quotes,...customQuotes]; return all[idx%all.length];}
function renderCountdown(){
 const w=new Date(data.date); const now=new Date(); const diff=w-now;
 const start=new Date(); start.setDate(now.getDate()-60);
 const total=Math.max(1,Math.ceil((w-start)/86400000));
 const elapsed=Math.max(0,total-Math.max(0,Math.ceil(diff/86400000)));
 const days=Math.max(0,Math.floor(diff/86400000)), hours=Math.max(0,Math.floor((diff%86400000)/3600000)), mins=Math.max(0,Math.floor((diff%3600000)/60000)), secs=Math.max(0,Math.floor((diff%60000)/1000));
 const grid=document.getElementById('countGrid');
 if(diff<=0 && diff>-86400000) grid.innerHTML=`<div class="count-box" style="grid-column:span 4;background:linear-gradient(135deg,var(--blush),var(--gold));color:white"><b>TODAY IS THE DAY! ✨</b></div>`;
 else if(diff<0){const m=Math.abs(Math.floor(diff/86400000)); grid.innerHTML=`<div class="count-box" style="grid-column:span 4"><b>💍 Married for ${m} days!</b></div>`;}
 else grid.innerHTML=`<div class="count-box"><b>${days}</b><span>Days</span></div><div class="count-box"><b>${hours}</b><span>Hours</span></div><div class="count-box"><b>${mins}</b><span>Minutes</span></div><div class="count-box"><b>${secs}</b><span>Seconds</span></div>`;
 document.getElementById('prog').style.width=Math.min(100,Math.max(5,Math.round((elapsed/total)*100)))+'%';
 document.getElementById('dayInfo').textContent=diff>0?`Day ${elapsed} of ${total} • BJ EDITION`:`Married`;
 document.getElementById('sub').textContent=`${data.c1} & ${data.c2} • ${new Date(data.date).toLocaleDateString('en-US',{weekday:'long',day:'numeric',month:'long',year:'numeric'})}`;
 const heroEl=document.getElementById('heroTitle');
 if(heroEl){ heroEl.innerHTML=`Our countdown to <span style="color:var(--sage)">forever</span> — <span style="color:var(--gold);border-bottom:2px dashed var(--gold)">${data.c1} & ${data.c2}</span> ✨<br><span class="small" style="font-size:11px">TAP HERE TO EDIT THE NAMES ✏️ - BJ EDITION</span>`; }
 document.getElementById('todayInfo').textContent=new Date().toLocaleDateString('en-US',{weekday:'long'});
}
let curOff=0,curForced=null;
function renderQuote(off=0,forced=null){
 const idx=forced!==null?forced:getDailyIndex(off);
 const q=getQuote(idx);
 const isFav=favorites.includes(idx);
 const dateStr=new Date(Date.now()+off*86400000).toLocaleDateString('en-US',{weekday:'long',day:'numeric',month:'long'});
 document.getElementById('quoteCard').innerHTML=`<div class="small">${off===0?'Today • '+dateStr:dateStr} • Day ${idx+1} • BJ EDITION</div><div style="font-size:48px;color:var(--blush);font-family:Didot,Georgia,serif">“</div><div class="q-text">${q.text}</div><div style="display:flex;justify-content:space-between;flex-wrap:wrap;gap:8px"><div><span class="badge badge-${q.cat.toLowerCase()}">${q.cat}</span> <span class="small">— ${q.author}</span></div><div style="display:flex;gap:6px"><button class="btn btn-ghost" onclick="shuffleQuote()">↻ New</button><button class="btn ${isFav?'':'btn-ghost'}" style="${isFav?'background:var(--gold);color:white':''}" onclick="toggleFav(${idx})">${isFav?'❤️':'🤍'} Save</button><button class="btn btn-dark" onclick="copyQuote(${idx})">Copy</button></div></div>`;
}
function shuffleQuote(){curForced=Math.floor(Math.random()*(quotes.length+customQuotes.length)); renderQuote(curOff,curForced);}
function toggleFav(idx){if(favorites.includes(idx)) favorites=favorites.filter(i=>i!==idx); else favorites.push(idx); save(); renderQuote(curOff,curForced); renderList(); toast(favorites.includes(idx)?'Saved ❤️':'Removed');}
function copyQuote(idx){
 const q=getQuote(idx); const text=`"${q.text}" — ${q.author} 💍 ${data.c1} & ${data.c2} - ${data.date} - BJ EDITION`;
 if(navigator.clipboard&&window.isSecureContext) navigator.clipboard.writeText(text).then(()=>toast('Copied! 💌')).catch(()=>fallbackCopy(text));
 else fallbackCopy(text);
}
function fallbackCopy(text){const a=document.createElement('textarea');a.value=text;a.style.position='fixed';a.style.opacity='0';document.body.appendChild(a);a.select();try{document.execCommand('copy');toast('Copied! 💌');}catch{toast('Select and copy the phrase');}a.remove();}
let activeTab='Today'; const tabs=['Today','Next 7 days','Favorites','Add yours'];
function renderTabs(){document.getElementById('tabs').innerHTML=tabs.map(t=>`<div class="tab ${t===activeTab?'active':''}" onclick="switchTab('${t}')">${t}</div>`).join('');}
function switchTab(t){activeTab=t; renderTabs(); renderList();}
function renderList(){
 const list=document.getElementById('list');
 if(activeTab==='Today') list.innerHTML=`<div class="mini"><b>How it works:</b> A new love phrase appears at midnight every day. Read it together each morning, save your favorites, or add your own in "Add yours."<br><br><span class="small">HTML download: extract the ZIP and open the file in a modern desktop browser. Your data stays on your device.</span></div>`;
 else if(activeTab==='Next 7 days') list.innerHTML=[1,2,3,4,5,6,7].map(off=>{const idx=getDailyIndex(off); const q=getQuote(idx); const d=new Date(Date.now()+off*86400000).toLocaleDateString('en-US',{weekday:'short',day:'numeric'}); return `<div class="mini" onclick="curOff=${off};curForced=${idx};renderQuote(${off},${idx});window.scrollTo({top:0,behavior:'smooth'})"><b>${d}</b> <span class="badge badge-${q.cat.toLowerCase()}">${q.cat}</span><div style="margin-top:6px">${q.text.slice(0,90)}...</div></div>`;}).join('');
 else if(activeTab==='Favorites') list.innerHTML=favorites.length?favorites.map(idx=>{const q=getQuote(idx); return `<div class="mini">"${q.text}" — ${q.author}</div>`;}).join(''):`<div class="mini">No favorites yet. Tap 🤍 Save.</div>`;
 else list.innerHTML=`<div class="mini"><b>Add your own phrase</b><div style="margin-top:10px;display:grid;gap:8px"><textarea id="customText" style="border:1px solid var(--line);border-radius:16px;padding:12px;min-height:80px" placeholder="My love, I love it when..."></textarea><input id="customAuthor" style="border:1px solid var(--line);border-radius:999px;padding:10px" placeholder="From (e.g. Alex)"><button class="btn btn-dark" onclick="addCustom()">+ Add</button></div></div>${customQuotes.map((q,i)=>`<div class="mini">"${q.text}" — ${q.author} <span onclick="delCustom(${i})" style="text-decoration:underline;cursor:pointer">Delete</span></div>`).join('')}`;
}
function addCustom(){const t=document.getElementById('customText').value.trim(); const a=document.getElementById('customAuthor').value.trim()||data.c1; if(!t) return; customQuotes.push({text:t,author:a,cat:'Love'}); save(); renderList(); renderQuote(curOff,curForced); toast('Added!'); document.getElementById('customText').value='';}
function delCustom(i){customQuotes.splice(i,1); save(); renderList();}
function editNames(){
  const n1=prompt('Name 1 (editable):', data.c1);
  if(n1!==null && n1!=='') data.c1=n1;
  const n2=prompt('Name 2 (editable):', data.c2);
  if(n2!==null && n2!=='') data.c2=n2;
  document.getElementById('c1').value=data.c1;
  document.getElementById('c2').value=data.c2;
  save(); renderCountdown(); toast(`Names updated: ${data.c1} & ${data.c2} ❤️`);
}
document.getElementById('c1').addEventListener('input',e=>{data.c1=e.target.value; save(); renderCountdown();});
document.getElementById('c2').addEventListener('input',e=>{data.c2=e.target.value; save(); renderCountdown();});
document.getElementById('c1').addEventListener('dblclick',editNames);
document.getElementById('c2').addEventListener('dblclick',editNames);
document.getElementById('wDate').addEventListener('input',e=>{data.date=e.target.value; save(); renderCountdown();});
document.getElementById('wDate').value=data.date;
document.getElementById('c1').value=data.c1;
document.getElementById('c2').value=data.c2;
renderTabs(); renderCountdown(); renderQuote(); renderList();
setInterval(renderCountdown,1000);
</script>
